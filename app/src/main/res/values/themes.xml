<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window from the very first frame: no white flash, no light "box" behind the app -->
    <style name="Theme.SmartBillScanner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
